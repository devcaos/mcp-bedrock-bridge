# Copy this file to .env.local (gitignored) for `npm run test:bedrock`. Never commit .env.local.
# These are the standard AWS SDK variables; AWS_PROFILE works instead of the access keys.
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials: uncomment and fill in.
# AWS_SESSION_TOKEN=
# Optional. Default: eu.amazon.nova-2-lite-v1:0
BEDROCK_MODEL_ID=
